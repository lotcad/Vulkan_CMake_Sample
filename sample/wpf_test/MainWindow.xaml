<Window x:Class="LotCadWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LotCadWpf"
        Title="LotCAD — WPF 호스트" Height="740" Width="1120"
        Background="#1E1F22">

    <Window.Resources>
        <!-- 납작 버튼 — 오른쪽 패널(해석·도면·도구)이 쓴다 -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#2B2D31"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3E44"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D6CDF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 메뉴바 다크 -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#1E1F22"/>
            <Setter Property="Foreground" Value="#D8D8D8"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 메뉴바 -->
        <Menu DockPanel.Dock="Top" Padding="4,2" FontSize="12.5">
            <MenuItem Header="파일(_F)" Foreground="#E6E6E6">
                <MenuItem Header="열기..." Foreground="#1B1B1B" Click="OnOpen"/>
                <MenuItem Header="다른 이름으로 저장..." Foreground="#1B1B1B" Click="OnSaveAs"/>
                <MenuItem Header="내보내기..." Foreground="#1B1B1B" Click="OnExport"/>
                <Separator/>
                <MenuItem Header="모두 지움" Foreground="#1B1B1B" Click="OnClearAll"/>
                <Separator/>
                <MenuItem Header="종료" Foreground="#1B1B1B" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="편집(_E)" Foreground="#E6E6E6">
                <MenuItem Header="실행 취소 (Undo)" Foreground="#1B1B1B" Click="OnUndo"/>
                <MenuItem Header="다시 실행 (Redo)" Foreground="#1B1B1B" Click="OnRedo"/>
                <Separator/>
                <MenuItem Header="전체 선택" Foreground="#1B1B1B" Click="OnSelectAll"/>
                <MenuItem Header="선택 삭제" Foreground="#1B1B1B" Click="OnDelete"/>
            </MenuItem>
            <MenuItem Header="뷰(_V)" Foreground="#E6E6E6">
                <MenuItem Header="정면" Foreground="#1B1B1B" Click="OnViewFront"/>
                <MenuItem Header="평면" Foreground="#1B1B1B" Click="OnViewTop"/>
                <MenuItem Header="Isometric" Foreground="#1B1B1B" Click="OnViewIso"/>
                <Separator/>
                <MenuItem Header="줌 맞춤" Foreground="#1B1B1B" Click="OnZoom"/>
                <MenuItem Header="투영 전환 (Ortho/Persp)" Foreground="#1B1B1B" Click="OnToggleProj"/>
            </MenuItem>
            <!-- 도면 — 엔진에선 ImGui 창이 여는 것들. 블록 만들기·편집은 명령행이 이름·기준점을 묻는 엔진 명령 -->
            <MenuItem Header="도면(_D)" Foreground="#E6E6E6">
                <MenuItem Header="도면층" Foreground="#1B1B1B" Click="OnLayers"/>
                <MenuItem Header="선종류" Foreground="#1B1B1B" Click="OnLinetypes"/>
                <Separator/>
                <MenuItem Header="블록 만들기 (선택한 객체로)" Foreground="#1B1B1B" Click="OnBlockCreate"/>
                <MenuItem Header="블록 편집 (선택한 블록 참조)" Foreground="#1B1B1B" Click="OnBlockEdit"/>
                <MenuItem Header="블록·외부 참조" Foreground="#1B1B1B" Click="OnBlocks"/>
            </MenuItem>
            <!-- 도구 — 이미지 편집은 선택한 이미지에 먹는 엔진 명령, 붙이기만 호스트 파일 창 -->
            <MenuItem Header="도구(_T)" Foreground="#E6E6E6">
                <MenuItem x:Name="GraphItem" Header="노드 그래프" Foreground="#1B1B1B" Click="OnGraph"/>
                <MenuItem Header="분해도" Foreground="#1B1B1B" Click="OnExplode"/>
                <MenuItem Header="메시 수리" Foreground="#1B1B1B" Click="OnMesh"/>
                <Separator/>
                <MenuItem Header="이미지" Foreground="#1B1B1B">
                    <MenuItem Header="붙이기..." Click="OnImageAttach"/>
                    <MenuItem Header="90° 회전" Click="OnImageRotate"/>
                    <MenuItem Header="좌우 뒤집기" Click="OnImageFlip"/>
                    <MenuItem Header="배경 지우기 (클릭)" Click="OnImageBackground"/>
                    <MenuItem Header="자르기 (두 구석)" Click="OnImageCrop"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="DynItem" Header="동적 입력" InputGestureText="F12" IsChecked="True" Foreground="#1B1B1B" Click="OnDynInput"/>
            </MenuItem>
            <MenuItem Header="해석(_A)" Foreground="#E6E6E6">
                <MenuItem Header="바람 터널" Foreground="#1B1B1B" Click="OnWindTunnel"/>
                <MenuItem Header="물" Foreground="#1B1B1B" Click="OnWater"/>
                <MenuItem Header="구조 해석" Foreground="#1B1B1B" Click="OnStructural"/>
            </MenuItem>
        </Menu>

        <!-- 리본 — 탭·그룹·버튼은 MainWindow.Ribbon.cs 가 채운다(MFC 샘플과 같은 구성) -->
        <local:RibbonBar DockPanel.Dock="Top" x:Name="Ribbon"/>

        <!-- 상태바 -->
        <Border DockPanel.Dock="Bottom" Background="#232529" BorderBrush="#111214" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,5">
                <TextBlock x:Name="InfoText" DockPanel.Dock="Right" Foreground="#8CB4FF" Text=""/>
                <TextBlock x:Name="StatusText" Foreground="#B8BCC4" Text="준비"/>
            </DockPanel>
        </Border>

        <!-- 좌: 정보, 가운데: Vulkan 렌더, 우: 패널 하나(해석 · 도면 · 도구 — 메뉴가 연다) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <local:AnalysisPanel Grid.Column="2" x:Name="Analysis"/>
            <local:LayerPanel Grid.Column="2" x:Name="Layers"/>
            <local:ToolsPanel Grid.Column="2" x:Name="Tools"/>

            <Border Grid.Column="0" Background="#1E1F22" BorderBrush="#111214" BorderThickness="0,0,1,0">
                <StackPanel Margin="14">
                    <TextBlock Text="LotCAD" Foreground="#F0F0F0" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="WPF 호스트 샘플" Foreground="#7C818B" FontSize="11" Margin="0,1,0,0"/>
                    <Border Height="1" Background="#2E3136" Margin="0,12"/>
                    <TextBlock Text="조작" Foreground="#9AA0AA" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Foreground="#B8BCC4" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="우클릭 드래그 — 회전&#x0a;중클릭 드래그 — 팬&#x0a;휠 — 줌&#x0a;좌클릭 — 선택"/>
                    <Border Height="1" Background="#2E3136" Margin="0,12"/>
                    <TextBlock Text="씬" Foreground="#9AA0AA" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SceneInfo" Foreground="#8CB4FF" FontSize="12.5" Margin="0,4,0,0" Text="객체 0 · 선택 0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" x:Name="RenderHost" Background="Black"/>
        </Grid>
    </DockPanel>
</Window>
